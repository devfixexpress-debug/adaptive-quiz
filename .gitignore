# =========================
# Environment / Secrets
# =========================
.secrets/*
!.secrets/
!.secrets/*.example

# Archivos ambientales reales (no versionar secretos)
.env
.env.*
!.env.example
!.env.*.example
*.env
!*.env.example
env.dev
env.qa
env.uat
env.prod

# No versionar perfiles locales con credenciales reales
application-local.yml
application-dev-local.yml
application-secret.yml
application-secrets.yml
**/application-local.yml
**/application-dev-local.yml
**/application-secret.yml
**/application-secrets.yml

# Mantener templates si existen
!application-local.example.yml
!application-dev-local.example.yml
!**/application-local.example.yml
!**/application-dev-local.example.yml

